@startuml
title Laundry project - create and advance an order
skinparam monochrome true
skinparam shadowing false
autonumber
actor User
participant Main
participant LaundryManager
participant "Order.Builder" as Builder
participant Order
participant OrderState
participant StatusLogger
User -> Main : choose Create order and enter details
Main -> Main : compose services and choose pricing
Main -> LaundryManager : createOrder(customer, phone, items, pricing)
LaundryManager -> Builder : id(), customer(), pricing(), addItem()
LaundryManager -> Builder : build()
Builder -> Order : create validated order
Builder --> LaundryManager : order
LaundryManager -> Order : addObserver(logger)
LaundryManager -> Order : notifyObservers()
Order -> StatusLogger : update(order)
StatusLogger -> Order : addHistory(...)
LaundryManager --> Main : order
Main --> User : order number and total
User -> Main : choose Next status and enter ID
Main -> LaundryManager : advanceOrder(id)
LaundryManager -> Order : advance()
Order -> OrderState : next()
alt next stage exists
  OrderState --> Order : next state
  Order -> StatusLogger : update(order)
  StatusLogger -> Order : addHistory(...)
  Main --> User : updated status
else already Delivered
  OrderState --> Order : IllegalStateException
  Main --> User : error message
end
@enduml
