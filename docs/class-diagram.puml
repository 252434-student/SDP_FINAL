@startuml
title Laundry project - class diagram
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
class Main
class LaundryManager <<Facade>> {
  + createOrder(customer, phone, items, pricing): Order
  + getOrder(id): Order
  + getOrders()
  + advanceOrder(id)
}
class "Order.Builder" as Builder <<Builder>> {
  + id(int): Builder
  + customer(String, String): Builder
  + addItem(OrderItem): Builder
  + pricing(PricingStrategy): Builder
  + build(): Order
}
class Order {
  + advance()
  + addObserver(OrderObserver)
  + notifyObservers()
  + getStatus(): String
  + getHistory()
}
class OrderItem {
  + getTotal(): int
}
interface LaundryService {
  + getPrice(): int
  + getDescription(): String
}
class BaseLaundry
abstract class ServiceDecorator <<Decorator>>
class Ironing
class StainRemoval
class Packing
interface PricingStrategy <<Strategy>> {
  + calculate(int): int
  + getName(): String
}
class StandardPricing
class LoyaltyPricing
class ExpressPricing
interface OrderState <<State>> {
  + getName(): String
  + next(): OrderState
}
class ReceivedState
class WashingState
class DryingState
class ReadyState
class DeliveredState
interface OrderObserver <<Observer>> {
  + update(Order)
}
class StatusLogger
Main --> LaundryManager
LaundryManager o-- "0..*" Order
LaundryManager ..> Builder : creates order
LaundryManager ..> StatusLogger : subscribes
Builder ..> Order : creates
Builder --> PricingStrategy
Order o-- "1..*" OrderItem
Order --> "1" PricingStrategy
Order --> "1" OrderState
Order o-- "0..*" OrderObserver
OrderItem --> LaundryService
LaundryService <|.. BaseLaundry
LaundryService <|.. ServiceDecorator
ServiceDecorator o-- LaundryService : wrapped
ServiceDecorator <|-- Ironing
ServiceDecorator <|-- StainRemoval
ServiceDecorator <|-- Packing
PricingStrategy <|.. StandardPricing
PricingStrategy <|.. LoyaltyPricing
PricingStrategy <|.. ExpressPricing
OrderState <|.. ReceivedState
OrderState <|.. WashingState
OrderState <|.. DryingState
OrderState <|.. ReadyState
OrderState <|.. DeliveredState
OrderObserver <|.. StatusLogger
StatusLogger ..> Order : addHistory
@enduml
